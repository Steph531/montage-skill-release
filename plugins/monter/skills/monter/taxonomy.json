{
  "version": 1,
  "intensity_scale": {
    "1": "discret, peut se répéter",
    "2": "marqué, à utiliser avec parcimonie",
    "3": "fort, 1 à 2 fois par vidéo maximum"
  },
  "rules": [
    "Un seul son fort (intensité 3) par séquence de quelques secondes.",
    "Ne jamais utiliser le même fichier deux fois de suite : alterner pop_01..05, mouse_01..03.",
    "Placer le son 1 à 3 images avant le visuel qu'il accompagne.",
    "Garder le volume des SFX 6 à 12 dB sous la voix."
  ],
  "categories": {
    "transitions": {
      "role": "Passer d'un plan à un autre ou animer un mouvement d'écran",
      "use_when": [
        "coupe/changement de plan",
        "élément qui glisse ou balaie l'écran",
        "changement de sujet"
      ]
    },
    "ui": {
      "role": "Accompagner l'apparition ou l'interaction d'un élément d'interface",
      "use_when": [
        "texte, logo ou icône qui apparaît",
        "clic, saisie, notification",
        "validation d'une étape"
      ]
    },
    "impacts": {
      "role": "Appuyer un moment fort",
      "use_when": [
        "phrase choc",
        "révélation",
        "chute d'un élément à l'écran",
        "fin de section"
      ]
    },
    "tension": {
      "role": "Créer attente, suspense ou urgence",
      "use_when": [
        "montée avant une révélation",
        "compte à rebours",
        "surprise soudaine"
      ]
    },
    "reaction": {
      "role": "Commenter l'action : humour, réussite, échec",
      "use_when": [
        "gag ou moment gênant",
        "résultat positif",
        "résultat négatif"
      ]
    },
    "business": {
      "role": "Parler d'argent, de gain ou de progression",
      "use_when": [
        "prix, vente, revenu",
        "bonus ou amélioration",
        "niveau supérieur"
      ]
    },
    "divers": {
      "role": "Sons à usage ponctuel",
      "use_when": [
        "capture, photo, screenshot"
      ]
    }
  },
